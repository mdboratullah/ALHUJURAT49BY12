def derive_keys(password: str, salt_hex: str):
    k = hashlib.pbkdf2_hmac(
        "sha256",
        password.encode("utf-8"),
        bytes.fromhex(salt_hex),
        120000,
        dklen=64,
    )
    return k[:32], k[32:]


def xor_stream(data: bytes, key: bytes) -> bytes:
    out, i = bytearray(), 0
    while len(out) < len(data):
        out.extend(hashlib.sha256(key + i.to_bytes(8, "big")).digest())
        i += 1
    return bytes(b ^ s for b, s in zip(data, out[: len(data)]))


def encrypt_text(plain_text: str, password: str) -> dict:
    salt_hex = secrets.token_hex(16)
    enc_k, mac_k = derive_keys(password, salt_hex)
    cipher = xor_stream(plain_text.encode("utf-8"), enc_k)
    tag = hmac.new(mac_k, bytes.fromhex(salt_hex) + cipher, hashlib.sha256).hexdigest()
    return {"salt": salt_hex, "cipher": cipher.hex(), "hmac": tag}


def decrypt_text(payload: dict, password: str) -> str:
    salt_hex = payload["salt"]
    cipher = bytes.fromhex(payload["cipher"])
    enc_k, mac_k = derive_keys(password, salt_hex)
    expected = hmac.new(mac_k, bytes.fromhex(salt_hex) + cipher, hashlib.sha256).hexdigest()
    if not hmac.compare_digest(expected, payload["hmac"]):
        raise ValueError("Bad HMAC")
    return xor_stream(cipher, enc_k).decode("utf-8")


def load_state():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
        users = raw.get("users") or dict(DEFAULT_USERS)
        for k, v in DEFAULT_USERS.items():
            users.setdefault(k, v)
        return {
            "users": users,
            "vault_encrypted": raw.get("vault_encrypted"),
            "privacy_filter_enabled": bool(raw.get("privacy_filter_enabled", True)),
        }
    return {
        "users": dict(DEFAULT_USERS),
        "vault_encrypted": None,
        "privacy_filter_enabled": True,
    }


def save_state(st):
    with open(DATA_FILE, "w", encoding="utf-8") as f:
        json.dump(st, f, indent=2)


def get_network_status():
    local_ip = "127.0.0.1"
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("8.8.8.8", 80))
        local_ip = s.getsockname()[0]
        s.close()
    except Exception:
        pass

    public_ip = None
    for u in ("https://api.ipify.org", "https://ifconfig.me/ip"):
        try:
            v = urllib.request.urlopen(u, timeout=3).read().decode("utf-8").strip()
            if v:
                public_ip = v
                break
        except Exception:
            pass

    tor_ok = False
    try:
        ts = socket.create_connection(("127.0.0.1", 9051), timeout=1.5)
        ts.close()
        tor_ok = True
    except Exception:
        pass

    return {
        "ip": public_ip or local_ip,
        "ip_note": f"Live Public IP (Local: {local_ip})" if public_ip else "Local Network IP",
        "tor_detail": "Tor control port (9051) reachable" if tor_ok else "Tor control port (9051) not reachable",
    }


