@app.route("/api/privacy/check", methods=["POST"])
def api_privacy_check():
    t = ((request.get_json(silent=True) or {}).get("target") or "").strip().lower()
    if not load_state().get("privacy_filter_enabled", True):
        return jsonify({"ok": True, "message": "Anti-Tracker Domain Guard is OFF."})
    if not t:
        return jsonify({"ok": False, "message": "Enter a URL or domain to test."})
    m = [d for d in TRACKER_DOMAINS if d in t]
    if m:
        return jsonify({"ok": True, "message": f"Flagged tracker match: {', '.join(m)} (Block/avoid in browser)."})
    return jsonify({"ok": True, "message": f"No known tracker domain matched in '{t}'."})


