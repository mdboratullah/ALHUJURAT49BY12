@app.route("/api/toggle_user", methods=["POST"])
def api_toggle_user():
    b = request.get_json(silent=True) or {}
    if b.get("password", "") != MASTER_PASSWORD:
        return jsonify({"ok": False}), 401
    u = b.get("user")
